@prefix bsddm: <https://w3id.org/ifc2lbd/bsdd-meta#> .
@prefix bsddc: <https://identifier.buildingsmart.org/uri/buildingsmart/ifc/4.3/class/> .
@prefix opm:   <https://w3id.org/opm#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# ---------------------------------------------------------------------------
# Ontology declaration
# ---------------------------------------------------------------------------

<https://w3id.org/ifc2lbd/bsdd-meta>
    a owl:Ontology ;
    rdfs:label "bSDD Mapping Metadata Ontology"@en ;
    rdfs:comment
        "Vocabulary for representing bSDD property mapping results and IFC standard attributes in the ifc2lbd-neo conversion pipeline."@en .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

bsddm:PropertySet
    a owl:Class ;
    rdfs:label "PropertySet"@en ;
    rdfs:comment "An IFC property set node produced by the bSDD named-graph producer."@en .

bsddm:CustomPropertySet
    a owl:Class ;
    rdfs:subClassOf bsddm:PropertySet ;
    rdfs:label "CustomPropertySet"@en ;
    rdfs:comment "A property set whose name was not found in the bSDD class index."@en .

bsddm:QuantitySet
    a owl:Class ;
    rdfs:label "QuantitySet"@en ;
    rdfs:comment "An IFC quantity set node produced by the bSDD named-graph producer."@en .

bsddm:CustomQuantitySet
    a owl:Class ;
    rdfs:subClassOf bsddm:QuantitySet ;
    rdfs:label "CustomQuantitySet"@en ;
    rdfs:comment "A quantity set whose name was not found in the bSDD class index."@en .

bsddm:Property
    a owl:Class ;
    rdfs:subClassOf opm:Property ;
    rdfs:label "Property"@en ;
    rdfs:comment "A property node that was successfully matched (Mapped or Normalized) to a bSDD property code."@en .

bsddm:CustomProperty
    a owl:Class ;
    rdfs:subClassOf bsddm:Property ;
    rdfs:label "CustomProperty"@en ;
    rdfs:comment "A property node that could not be matched to any bSDD property (Unmapped)."@en .

bsddm:StandardAttribute
    a owl:Class ;
    rdfs:subClassOf opm:Property ;
    rdfs:label "StandardAttribute"@en ;
    rdfs:comment "An IFC standard attribute (GlobalId, Name, Description, Tag, elevation, etc.) expressed as an OPM property node. Linked from elements via bsddm:hasProperty; the specific attribute is identified by rdfs:label."@en .

bsddm:MappingStatus
    a owl:Class ;
    rdfs:label "MappingStatus"@en ;
    rdfs:comment "Superclass of all bSDD mapping status values."@en .

bsddm:Mapped
    a owl:Class ;
    rdfs:subClassOf bsddm:MappingStatus ;
    rdfs:label "Mapped"@en ;
    rdfs:comment "Exact match via hard override or exact class+pset+property key."@en .

bsddm:Normalized
    a owl:Class ;
    rdfs:subClassOf bsddm:MappingStatus ;
    rdfs:label "Normalized"@en ;
    rdfs:comment "Match via normalized lookup (pset/class/prop fallback) or fuzzy matching."@en .

bsddm:Ambiguous
    a owl:Class ;
    rdfs:subClassOf bsddm:MappingStatus ;
    rdfs:label "Ambiguous"@en ;
    rdfs:comment "Multiple candidate bSDD properties found; the mapping is unresolved."@en .

bsddm:Unmapped
    a owl:Class ;
    rdfs:subClassOf bsddm:MappingStatus ;
    rdfs:label "Unmapped"@en ;
    rdfs:comment "No bSDD property candidate found for this IFC property."@en .

# ---------------------------------------------------------------------------
# Object properties — structural
# ---------------------------------------------------------------------------

bsddm:hasPropertySet
    a owl:ObjectProperty ;
    rdfs:label "hasPropertySet"@en ;
    rdfs:comment "Links an IFC element or spatial node to a bsddm:PropertySet node."@en ;
    rdfs:range bsddm:PropertySet .

bsddm:hasQuantitySet
    a owl:ObjectProperty ;
    rdfs:label "hasQuantitySet"@en ;
    rdfs:comment "Links an IFC element or spatial node to a bsddm:QuantitySet node."@en ;
    rdfs:range bsddm:QuantitySet .

bsddm:hasProperty
    a owl:ObjectProperty ;
    rdfs:label "hasProperty"@en ;
    rdfs:comment "Direct attribution link from an IFC element or spatial node to a property node. Universal navigation predicate — covers all properties regardless of match status."@en ;
    rdfs:range opm:Property .

bsddm:containsProperty
    a owl:ObjectProperty ;
    rdfs:label "containsProperty"@en ;
    rdfs:comment "Membership link from a bsddm:PropertySet to its member property nodes. Enables pset-scoped queries."@en ;
    rdfs:domain bsddm:PropertySet ;
    rdfs:range opm:Property .

bsddm:containsQuantity
    a owl:ObjectProperty ;
    rdfs:label "containsQuantity"@en ;
    rdfs:comment "Membership link from a bsddm:QuantitySet to its member quantity nodes."@en ;
    rdfs:domain bsddm:QuantitySet ;
    rdfs:range opm:Property .

bsddm:mappingStatus
    a owl:ObjectProperty ;
    rdfs:label "mappingStatus"@en ;
    rdfs:comment "The bSDD mapping status of a property node."@en ;
    rdfs:domain opm:Property ;
    rdfs:range bsddm:MappingStatus .

bsddm:candidateProperty
    a owl:ObjectProperty ;
    rdfs:label "candidateProperty"@en ;
    rdfs:comment "Points to candidate bSDD property class IRIs for a property whose mapping is ambiguous. The targets are bSDD dictionary identifiers (bsddp: namespace), not confirmed types."@en ;
    rdfs:domain opm:Property .

# ---------------------------------------------------------------------------
# Datatype properties — mapping metadata
# ---------------------------------------------------------------------------

bsddm:matchingMethod
    a owl:DatatypeProperty ;
    rdfs:label "matchingMethod"@en ;
    rdfs:comment "The name of the matching strategy that produced this mapping result (e.g. exact_class_pset_prop, fuzzy, hard_override)."@en ;
    rdfs:domain opm:Property ;
    rdfs:range xsd:string .

bsddm:matchingConfidence
    a owl:DatatypeProperty ;
    rdfs:label "matchingConfidence"@en ;
    rdfs:comment "A confidence score in [0, 1] for the mapping result. 1.0 for exact matches, lower for fuzzy matches."@en ;
    rdfs:domain opm:Property ;
    rdfs:range xsd:decimal .

bsddm:classPropertyCode
    a owl:DatatypeProperty ;
    rdfs:label "classPropertyCode"@en ;
    rdfs:comment "The bSDD class-property code from the index exact_meta record, when available."@en ;
    rdfs:domain opm:Property ;
    rdfs:range xsd:string .

# Standard IFC attributes (GlobalId, Name, Description, Tag, elevations, dimensions)
# are now emitted as bsddm:StandardAttribute nodes linked via bsddm:hasProperty.
# The specific attribute is identified by rdfs:label on the property node.
# No named per-attribute predicates — uniform navigation via bsddm:hasProperty for all.
