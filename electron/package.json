{
  "name": "ifc2lbd-neo-desktop",
  "version": "0.2.7",
  "description": "IFC2LBD-Neo Desktop — IFC to LBD/RDF converter",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:dir": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "author": "IFC2LBD-Neo Contributors",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "io.github.isbe-tue.ifc2lbd-neo",
    "productName": "ifc2lbd-neo",
    "artifactName": "ifc2lbd-neo-desktop-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "resources/bin/macos",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "resources/bin/win32",
          "to": "bin",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
